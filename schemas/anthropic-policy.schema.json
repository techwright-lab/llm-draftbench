{
  "additionalProperties": false,
  "properties": {
    "account_route": {
      "pattern": "^[A-Za-z0-9._-]{1,128}$",
      "title": "Account Route",
      "type": "string"
    },
    "currency": {
      "const": "USD",
      "title": "Currency",
      "type": "string"
    },
    "price_unit": {
      "const": "currency_per_million_tokens",
      "default": "currency_per_million_tokens",
      "title": "Price Unit",
      "type": "string"
    },
    "pricing_provenance": {
      "enum": [
        "public-docs-2026-09-23-v1",
        "operator-reviewed-v1"
      ],
      "title": "Pricing Provenance",
      "type": "string"
    },
    "tracking_only": {
      "default": false,
      "title": "Tracking Only",
      "type": "boolean"
    },
    "verified_tariff_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verified Tariff Digest"
    },
    "input_per_million": {
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$",
      "title": "Input Per Million",
      "type": "string"
    },
    "output_per_million": {
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$",
      "title": "Output Per Million",
      "type": "string"
    },
    "max_cost": {
      "anyOf": [
        {
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Max Cost"
    },
    "max_output_tokens": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Max Output Tokens"
    },
    "max_requests": {
      "anyOf": [
        {
          "maximum": 30000,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Max Requests"
    },
    "max_total_tokens": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Max Total Tokens"
    },
    "max_input_bytes": {
      "anyOf": [
        {
          "maximum": 100000,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": 100000,
      "title": "Max Input Bytes"
    },
    "timeout_seconds": {
      "anyOf": [
        {
          "maximum": 300,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": 30,
      "title": "Timeout Seconds"
    },
    "contract": {
      "const": "anthropic-messages-text-v1",
      "default": "anthropic-messages-text-v1",
      "title": "Contract",
      "type": "string"
    },
    "model": {
      "enum": [
        "claude-opus-5-5",
        "claude-sonnet-5",
        "claude-sonnet-5-5",
        "claude-haiku-5-5",
        "claude-fable-5-1"
      ],
      "title": "Model",
      "type": "string"
    },
    "context_window_tokens": {
      "const": 1000000,
      "default": 1000000,
      "title": "Context Window Tokens",
      "type": "integer"
    },
    "thinking": {
      "default": "adaptive",
      "enum": [
        "adaptive",
        "disabled"
      ],
      "title": "Thinking",
      "type": "string"
    },
    "effort": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "title": "Effort",
      "type": "string"
    }
  },
  "required": [
    "account_route",
    "currency",
    "pricing_provenance",
    "input_per_million",
    "output_per_million",
    "max_cost",
    "max_output_tokens",
    "max_requests",
    "max_total_tokens",
    "model",
    "effort"
  ],
  "title": "AnthropicPolicy",
  "type": "object"
}
