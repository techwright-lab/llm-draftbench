{
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "openai-chat-text-v1",
      "default": "openai-chat-text-v1",
      "title": "Contract",
      "type": "string"
    },
    "model": {
      "pattern": "^gpt-4\\.1(?:-mini|-nano)?-2025-04-14$",
      "title": "Model",
      "type": "string"
    },
    "account_route": {
      "pattern": "^[A-Za-z0-9._-]{1,128}$",
      "title": "Account Route",
      "type": "string"
    },
    "organization": {
      "pattern": "^org_[A-Za-z0-9_-]+$",
      "title": "Organization",
      "type": "string"
    },
    "project": {
      "pattern": "^proj_[A-Za-z0-9_-]+$",
      "title": "Project",
      "type": "string"
    },
    "currency": {
      "pattern": "^[A-Z]{3}$",
      "title": "Currency",
      "type": "string"
    },
    "price_unit": {
      "const": "currency_per_million_tokens",
      "default": "currency_per_million_tokens",
      "title": "Price Unit",
      "type": "string"
    },
    "input_per_million": {
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$",
      "title": "Input Per Million",
      "type": "string"
    },
    "output_per_million": {
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$",
      "title": "Output Per Million",
      "type": "string"
    },
    "max_cost": {
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$",
      "title": "Max Cost",
      "type": "string"
    },
    "context_window_tokens": {
      "const": 1047576,
      "title": "Context Window Tokens",
      "type": "integer"
    },
    "max_output_tokens": {
      "maximum": 32768,
      "minimum": 1,
      "title": "Max Output Tokens",
      "type": "integer"
    },
    "max_requests": {
      "maximum": 30000,
      "minimum": 1,
      "title": "Max Requests",
      "type": "integer"
    },
    "max_total_tokens": {
      "minimum": 1,
      "title": "Max Total Tokens",
      "type": "integer"
    },
    "max_input_bytes": {
      "default": 100000,
      "maximum": 1000000,
      "minimum": 1,
      "title": "Max Input Bytes",
      "type": "integer"
    },
    "timeout_seconds": {
      "default": 30,
      "maximum": 300,
      "minimum": 1,
      "title": "Timeout Seconds",
      "type": "integer"
    }
  },
  "required": [
    "model",
    "account_route",
    "organization",
    "project",
    "currency",
    "input_per_million",
    "output_per_million",
    "max_cost",
    "context_window_tokens",
    "max_output_tokens",
    "max_requests",
    "max_total_tokens"
  ],
  "title": "OpenAIPolicy",
  "type": "object"
}
