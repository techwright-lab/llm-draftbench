# Dummy values only. Judge runs load ONLY the file passed to judge run --env-file.
# Same rules as .env.example: mode 0600, owner, regular file, literal NAME=value.
# All six names are required; the pilot loader still accepts exactly its four.
DRAFTBENCH_OPENAI_API_KEY=REPLACE_WITH_LAB_OPENAI_API_KEY
DRAFTBENCH_OPENAI_ORGANIZATION=org_REPLACE_WITH_LAB_ORGANIZATION
DRAFTBENCH_OPENAI_PROJECT=proj_REPLACE_WITH_LAB_PROJECT
DRAFTBENCH_ANTHROPIC_API_KEY=REPLACE_WITH_LAB_ANTHROPIC_API_KEY
DRAFTBENCH_TYPESAFE_API_KEY=REPLACE_WITH_LAB_TYPESAFE_API_KEY
DRAFTBENCH_GOOGLE_API_KEY=REPLACE_WITH_LAB_GOOGLE_API_KEY
