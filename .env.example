# Dummy values only. Replace locally after merge; never commit .env.
# Loaded ONLY by pilot run/resume --env-file /explicit/path after exact approval.
# Require mode 0600, current owner, regular file, no symlinks/hard links.
# Literal NAME=value only; no quotes, export, inline comments or interpolation.
# Never source this file. No ambient or automatic dotenv lookup is performed.
# Existing .env must be edited locally, never copied over or printed.
# Match organization/project to the privately reviewed pilot config.
# See schemas/PILOT_OPERATOR.md; dummy/empty values fail before SDK dispatch.
DRAFTBENCH_OPENAI_API_KEY=REPLACE_WITH_LAB_OPENAI_API_KEY
DRAFTBENCH_OPENAI_ORGANIZATION=org_REPLACE_WITH_LAB_ORGANIZATION
DRAFTBENCH_OPENAI_PROJECT=proj_REPLACE_WITH_LAB_PROJECT
DRAFTBENCH_ANTHROPIC_API_KEY=REPLACE_WITH_LAB_ANTHROPIC_API_KEY
